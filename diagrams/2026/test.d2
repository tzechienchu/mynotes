direction: up

Arduino_Uno: "Arduino Uno (Rev3)" {
  style: {
    fill: "#00979C"
    stroke: "#005C5F"
    stroke-width: 3
    font-color: "#FFFFFF"
    border-radius: 8
  }

  # --- Top Pin Headers (Digital & Communication) ---
  Digital_Pins: "Digital I/O & PWM" {
    direction: right
    style: {
      fill: "#1E1E1E"
      font-color: "#FFFFFF"
      border-radius: 4
    }
    
    SCL: "SCL"
    SDA: "SDA"
    AREF: "AREF"
    GND_Top: "GND"
    D13: "D13 (SCK / LED)"
    D12: "D12 (MISO)"
    D11: "D11 (~MOSI)"
    D10: "D10 (~SS)"
    D9: "D9 (~)"
    D8: "D8"
    D7: "D7"
    D6: "D6 (~)"
    D5: "D5 (~)"
    D4: "D4"
    D3: "D3 (~INT1)"
    D2: "D2 (INT0)"
    D1: "D1 (TX)"
    D0: "D0 (RX)"
  }

  # --- Left Side Inputs (Power & USB) ---
  USB_Port: "USB Type-B\n(5V & Serial)" {
    shape: rectangle
    style: {
      fill: "#C0C0C0"
      stroke: "#555555"
      font-color: "#000000"
    }
  }

  Barrel_Jack: "DC Power Jack\n(7-12V Input)" {
    shape: rectangle
    style: {
      fill: "#222222"
      font-color: "#FFFFFF"
    }
  }

  # --- Center Components ---
  ATmega16U2: "ATmega16U2\n(USB-to-Serial)" {
    style: {
      fill: "#2B2B2B"
      font-color: "#FFFFFF"
    }
  }

  Reset_Btn: "RESET" {
    shape: circle
    style: {
      fill: "#D9534F"
      font-color: "#FFFFFF"
    }
  }

  Voltage_Reg: "5V / 3.3V\nRegulators" {
    style: {
      fill: "#333333"
      font-color: "#FFFFFF"
    }
  }

  ATmega328P: "ATmega328P-PU\n(Main Microcontroller - 16MHz)" {
    style: {
      fill: "#1A1A1A"
      stroke: "#888888"
      stroke-width: 2
      font-color: "#FFFFFF"
    }
  }

  ICSP: "ICSP Header" {
    grid-rows: 2
    grid-columns: 3
    style: {
      fill: "#333333"
      font-color: "#CCCCCC"
    }
    MISO; VCC; SCK; MOSI; RST; GND
  }

  # --- Bottom Pin Headers (Power & Analog) ---
  Power_Pins: "Power" {
    direction: right
    style: {
      fill: "#1E1E1E"
      font-color: "#FFFFFF"
      border-radius: 4
    }

    IOREF: "IOREF"
    RESET: "RESET"
    V3_3: "3.3V"
    V5: "5V"
    GND1: "GND"
    GND2: "GND"
    VIN: "VIN"
  }

  Analog_Pins: "Analog In" {
    direction: right
    style: {
      fill: "#1E1E1E"
      font-color: "#FFFFFF"
      border-radius: 4
    }

    A0: "A0"
    A1: "A1"
    A2: "A2"
    A3: "A3"
    A4: "A4 (SDA)"
    A5: "A5 (SCL)"
  }

  # --- Internal Connections ---
  USB_Port -> ATmega16U2: "USB D+/D-"
  USB_Port -> Voltage_Reg: "5V"
  Barrel_Jack -> Voltage_Reg: "7-12V"
  
  Voltage_Reg -> Power_Pins.V5: "5V"
  Voltage_Reg -> Power_Pins.V3_3: "3.3V"
  Voltage_Reg -> ATmega328P: "VCC"

  ATmega16U2 <-> ATmega328P: "UART (TX/RX)"
  Reset_Btn -> ATmega328P: "Reset"
  
  ATmega328P <-> Digital_Pins: "Port B / D"
  ATmega328P <- Analog_Pins: "ADC (Port C)"
  ATmega328P <-> ICSP: "SPI"
}
